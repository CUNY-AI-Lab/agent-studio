{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-studio",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "src/server.ts",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "VITE_BASE_PATH=/agent-studio bun run --cwd ../frontend build",
    "cwd": ".",
    "watch_dir": ["src", "../frontend/src", "../frontend/index.html"]
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      { "name": "WorkspaceAgent", "class_name": "WorkspaceAgent" },
      { "name": "MIGRATION_REGISTRY", "class_name": "MigrationRegistry" }
    ]
  },
  "exports": {
    "WorkspaceAgent": { "type": "durable-object", "storage": "sqlite" },
    "MigrationRegistry": { "type": "durable-object", "storage": "sqlite" }
  },
  "r2_buckets": [{
    "binding": "WORKSPACE_FILES",
    "bucket_name": "agent-studio",
    "preview_bucket_name": "agent-studio-preview"
  }],
  "unsafe": {
    "bindings": [
      {
        "name": "HEAVY_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "4002",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },
  "services": [{ "binding": "GATEWAY", "service": "cail-model-api" }],
  "vars": {
    "CAIL_API_BASE": "https://cail-model-api.ailab-452.workers.dev",
    "CAIL_MODEL": "@cf/zai-org/glm-5.2",
    "CAIL_IDENTITY_ISSUER": "https://cail-doorway.ailab-452.workers.dev/cail-sso",
    "CAIL_CANONICAL_ORIGIN": "https://cail-doorway.ailab-452.workers.dev",
    "CAIL_BASE_PATH": "/agent-studio",
    "CAIL_REQUIRE_IDENTITY": "true"
  },
  "env": {
    "staging": {
      "name": "agent-studio-staging",
      "secrets": {
        "required": [
          "SESSION_SECRET",
          "CAIL_IDENTITY_JWKS"
        ]
      },
      "worker_loaders": [{ "binding": "LOADER" }],
      "durable_objects": {
        "bindings": [
          { "name": "WorkspaceAgent", "class_name": "WorkspaceAgent" },
          { "name": "MIGRATION_REGISTRY", "class_name": "MigrationRegistry" }
        ]
      },
      "exports": {
        "WorkspaceAgent": { "type": "durable-object", "storage": "sqlite" },
        "MigrationRegistry": { "type": "durable-object", "storage": "sqlite" }
      },
      "r2_buckets": [{
        "binding": "WORKSPACE_FILES",
        "bucket_name": "agent-studio-preview"
      }],
      "unsafe": {
        "bindings": [
          {
            "name": "HEAVY_RATE_LIMIT",
            "type": "ratelimit",
            "namespace_id": "4002",
            "simple": { "limit": 20, "period": 60 }
          }
        ]
      },
      "services": [{ "binding": "GATEWAY", "service": "cail-model-api-staging" }],
      "vars": {
        "CAIL_API_BASE": "https://cail-model-api-staging.ailab-452.workers.dev",
        "CAIL_MODEL": "@cf/zai-org/glm-5.2",
        "CAIL_IDENTITY_ISSUER": "https://cail-doorway.ailab-452.workers.dev/cail-sso",
        "CAIL_CANONICAL_ORIGIN": "https://cail-doorway.ailab-452.workers.dev",
        "CAIL_BASE_PATH": "/agent-studio",
        "CAIL_REQUIRE_IDENTITY": "true"
      }
    }
  }
}
